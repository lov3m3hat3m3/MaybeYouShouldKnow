---
// src/components/SearchBox.astro
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';

const configPath = path.resolve('./public/admin/config.yml');
const configFile = fs.readFileSync(configPath, 'utf8');
const config = yaml.load(configFile) as any;

const itemsCollection = config.collections.find((c: any) => c.name === 'items');
const categoryField = itemsCollection?.fields.find((f: any) => f.name === 'category');
const cmsCategories: string[] = categoryField?.options || [];

// Add the "Tất cả" option to the front of the UI array
const categories = ["Tất cả", ...cmsCategories];
---

<div class="w-full max-w-2xl mx-auto" data-search-box>
  <div class="relative">
    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
      <svg class="w-5 h-5 text-ink-muted" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
    </div>
    <input
      type="text"
      data-search-input
      placeholder="Nhập từ khóa hoặc chọn một chủ đề bên dưới để lọc..."
      class="w-full pl-11 pr-4 py-3.5 bg-white border border-border rounded-xl text-ink placeholder:text-ink-muted/60 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 shadow-sm text-base"
      aria-label="Tìm kiếm"
      autocomplete="off"
    />
  </div>

  <div class="flex flex-wrap gap-2 mt-3 justify-center">
    {categories.map((cat) => (
      <button
        type="button"
        data-category-filter={cat === "Tất cả" ? "" : cat}
        class="px-3 py-1 text-sm font-medium rounded-full border border-border bg-white text-ink-muted hover:border-brand-300 hover:text-brand-700 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-400"
      >
        {cat}
      </button>
    ))}
  </div>
  <div class="text-center mt-6 hidden" data-category-link-container>
  <a 
    href="#" 
    data-category-link 
    class="text-sm font-medium text-brand-600 hover:text-brand-700 hover:underline inline-flex items-center gap-1"
  >
    <span>Xem tất cả bài viết</span>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
    </svg>
  </a>
</div>

  <div data-search-results class="mt-4 hidden">
    <div class="bg-white border border-border rounded-xl shadow-lg overflow-hidden">
      <ul data-results-list role="listbox" class="divide-y divide-border max-h-80 overflow-y-auto"></ul>
      <div data-search-empty class="hidden px-4 py-6 text-center text-ink-muted text-sm">
        Không tìm thấy kết quả. Hãy thử từ khóa khác.
      </div>
    </div>
  </div>
</div>

<script>
  import { slugify } from '../lib/utils';

  type PagefindResult = {
    id: string;
    url: string;
    meta: Record<string, string>;
    excerpt: string;
  };

  let pagefindApi: any = null;
  let activeCategory = "";

async function initPagefind() {
  if (pagefindApi) return pagefindApi;
  try {
    // Using a variable prevents Vite from trying to resolve the path during compilation
    const pagefindPath = "/pagefind/pagefind.js";
    const pf = await import(/* @vite-ignore */ pagefindPath);
    
    pagefindApi = pf;
    return pf;
  } catch (err) {
    console.warn("Pagefind is not ready (this is normal in dev mode):", err);
    return null;
  }
}

  //Constants
  // DOM element selectors
  const boxes = document.querySelectorAll<HTMLElement>("[data-search-box]");

  boxes.forEach((box) => {
    // DOM element selectors
    const input = box.querySelector<HTMLInputElement>("[data-search-input]");
    const resultsContainer = box.querySelector<HTMLElement>("[data-search-results]");
    const resultsList = box.querySelector<HTMLElement>("[data-results-list]");
    const emptyState = box.querySelector<HTMLElement>("[data-search-empty]");
    const categoryButtons = box.querySelectorAll<HTMLButtonElement>("[data-category-filter]");
    const linkContainer = box.querySelector<HTMLElement>("[data-category-link-container]");
    const categoryLink = box.querySelector<HTMLAnchorElement>("[data-category-link]");

    if (!input || !resultsContainer || !resultsList || !emptyState) return;

    function setActiveCategory(value: string) {
      activeCategory = value
      
      //Display search result box
      categoryButtons.forEach((btn) => {
        const cat = btn.getAttribute("data-category-filter") || "";
        const isActive = cat === value;
        btn.classList.toggle("bg-brand-600", isActive);
        btn.classList.toggle("text-white", isActive);
        btn.classList.toggle("border-brand-600", isActive);
        btn.classList.toggle("bg-white", !isActive);
        btn.classList.toggle("text-ink-muted", !isActive);
        btn.classList.toggle("border-border", !isActive);
      });

      //Display View all articles button
      if (linkContainer && categoryLink) {
        if (value === "" || value === "Tất cả") {
          linkContainer.classList.add("hidden");
        } else {
          linkContainer.classList.remove("hidden");
          // Helper to handle Vietnamese characters safely
          const slug = slugify(value);

          categoryLink.href = `/categories/${slug}`;
          categoryLink.querySelector("span")!.textContent = `Xem tất cả bài viết về ${value} →`;
        }
      }

      // Perform Search
      if (input.value.trim()) {
        performSearch(input.value.trim());
      }
    }

    categoryButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.getAttribute("data-category-filter") || "";
        setActiveCategory(cat);
      });
    });

    async function performSearch(query: string) {
      const pf = await initPagefind();
      if (!pf) {
        resultsContainer.classList.add("hidden");
        return;
      }

      const search = await pf.search(query, { filters: {} });
      let items: PagefindResult[] = [];

      if (search?.results) {
        for (const r of search.results.slice(0, 8)) {
          const data = await r.data?.();
          if (data) items.push(data);
        }
      }

      // Client-side category filter
      if (activeCategory) {
        items = items.filter((item) => item.meta?.category === activeCategory);
      }

      resultsList.innerHTML = "";

      if (items.length === 0) {
        resultsContainer.classList.remove("hidden");
        emptyState.classList.remove("hidden");
        return;
      }

      emptyState.classList.add("hidden");
      resultsContainer.classList.remove("hidden");

      for (const item of items) {
        const li = document.createElement("li");
        li.setAttribute("role", "option");
        const a = document.createElement("a");
        a.href = item.url;
        a.className = "block px-4 py-3 hover:bg-brand-50 transition-colors group";

        const title = document.createElement("p");
        title.className = "text-sm font-medium text-ink group-hover:text-brand-700 line-clamp-2";
        title.innerHTML = item.meta?.prompt || item.meta?.title || item.url;

        const cat = document.createElement("span");
        cat.className = "mt-1 inline-block text-xs font-semibold text-brand-600 bg-brand-100 px-2 py-0.5 rounded-full";
        cat.textContent = item.meta?.category || "Chủ đề";

        const excerpt = document.createElement("p");
        excerpt.className = "mt-1 text-xs text-ink-muted line-clamp-2";
        excerpt.innerHTML = item.excerpt || "";

        a.appendChild(title);
        a.appendChild(cat);
        if (item.excerpt) a.appendChild(excerpt);
        li.appendChild(a);
        resultsList.appendChild(li);
      }
    }

    let debounce: ReturnType<typeof setTimeout>;
    input.addEventListener("input", () => {
      clearTimeout(debounce);
      const query = input.value.trim();
      if (!query) {
        resultsContainer.classList.add("hidden");
        return;
      }
      debounce = setTimeout(() => performSearch(query), 150);
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        resultsContainer.classList.add("hidden");
        input.blur();
      }
    });

    document.addEventListener("click", (e) => {
      if (!box.contains(e.target as Node)) {
        resultsContainer.classList.add("hidden");
      }
    });
  });
</script>
