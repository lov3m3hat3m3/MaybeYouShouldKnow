---
// src/pages/events/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';
import 'flag-icons/css/flag-icons.min.css';

const allEvents = await getCollection('events');
const sortedEvents = allEvents.sort((a, b) => a.data.year - b.data.year);

const configPath = path.resolve('./public/admin/config.yml');
const configFile = fs.readFileSync(configPath, 'utf8');
const config = yaml.load(configFile) as any;

const eventsCollection = config.collections.find((c: any) => c.name === 'events');
const countryField = eventsCollection?.fields.find((f: any) => f.name === 'country');
const countryOptions: { label: string; value: string }[] = countryField?.options || [];

// Identify countries that actually contain events to avoid empty filter choices
const activeCountryCodes = new Set(allEvents.map(event => event.data.country));
const filteredCountryOptions = countryOptions.filter(opt => activeCountryCodes.has(opt.value));

const getCountryLabel = (code: string) => {
  return countryOptions.find((opt) => opt.value === code)?.label || code;
};
---

<Layout title="Sự kiện Lịch sử - Hiểu Đúng" description="Lịch sử phong trào lao động, giải phóng dân tộc và quyền lợi công nhân toàn cầu.">
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
    
    <header class="mb-8 pb-5 border-b border-border text-center md:text-left">
      <div class="text-sm font-semibold text-brand-600 uppercase tracking-wide mb-2">Tư liệu</div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink leading-tight mb-4">Sự kiện Lịch sử</h1>
      <div class="text-base sm:text-lg text-ink-muted leading-relaxed tracking-wide">
        Lịch sử phong trào lao động, giải phóng dân tộc và quyền lợi công nhân toàn cầu.
      </div>

      {/* Interactive Country Filter Pills */}
      <div class="flex flex-wrap gap-2 justify-center md:justify-start mt-4" data-event-filters>
        <button
          type="button"
          data-filter-value="all"
          class="px-3 py-1.5 text-xs font-semibold rounded-full border border-brand-600 bg-brand-600 text-white shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-brand-400 select-none cursor-pointer"
        >
          Tất cả
        </button>
        {filteredCountryOptions.map((country) => (
          <button
            type="button"
            data-filter-value={country.value}
            class="px-3 py-1.5 text-xs font-medium rounded-full border border-border bg-white text-ink-muted hover:border-brand-300 hover:text-brand-700 shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-brand-400 flex items-center gap-1.5 select-none cursor-pointer"
          >
            <span class={`fi fi-${country.value} text-xs rounded-sm shadow-sm`}></span>
            <span>{country.label}</span>
          </button>
        ))}
      </div>
    </header>

    <div class="relative border-l-2 border-slate-200 ml-4 md:ml-32 space-y-6">
      {sortedEvents.map((event) => {
        const countryLabel = getCountryLabel(event.data.country);
        
        return (
          /* Add data attributes for target tracking in our scripts */
          <div class="relative pl-6 md:pl-8 group timeline-card-wrapper transition-all duration-200" data-country={event.data.country}>
            
            <div class="hidden md:block md:absolute md:-left-36 md:top-1 md:w-28 md:text-right font-mono font-bold text-brand-600 text-sm timeline-date-element">
              {event.data.displayDate}
            </div>

            <div class="absolute -left-[7px] top-2.5 w-3.5 h-3.5 rounded-full border-2 border-white bg-slate-300 group-hover:bg-brand-600 group-hover:scale-110 transition-all duration-150 timeline-dot-element" />
            
            <details class="bg-white rounded-lg border border-border shadow-sm hover:border-slate-300 transition-colors duration-150 overflow-hidden [&_summary::-webkit-details-marker]:hidden">
              
              <summary class="p-5 cursor-pointer list-none select-none focus:outline-none">
                <div class="flex flex-col gap-1">
                  <span class="inline-block md:hidden font-mono font-bold text-brand-600 text-xs mb-1">
                    {event.data.displayDate}
                  </span>
                  
                  <div class="flex items-start justify-between gap-4">
                    <h3 class="text-lg font-bold text-ink group-hover:text-brand-600 transition-colors duration-150 leading-snug">
                      {event.data.title}
                    </h3>
                    <span class="text-slate-400 text-xs shrink-0 mt-1.5 toggle-text flex items-center gap-1 select-none">
                      <span class="label-text">Xem thêm</span>
                      <span class="inline-block arrow-icon transition-transform duration-150">▼</span>
                    </span>
                  </div>
                  
                  <div class="text-xs font-medium text-ink-muted mt-1 flex items-center gap-2">
                    <span class={`fi fi-${event.data.country} text-sm rounded-sm shadow-sm select-none`} title={countryLabel}></span>
                    <span>{event.data.location}, {countryLabel}</span>
                  </div>
                </div>
              </summary>
              
              <div class="px-5 pb-5 pt-3 border-t border-dashed border-border bg-slate-50/50">
                <p class="text-sm text-ink leading-relaxed mb-4 font-normal">
                  {event.data.summary}
                </p>

                <div>
                  <a 
                    href={`/events/${event.data.slug}`} 
                    class="inline-flex items-center text-xs font-bold text-brand-600 hover:text-brand-700 hover:underline gap-0.5"
                  >
                    Đọc thêm →
                  </a>
                </div>
              </div>

            </details>

          </div>
        );
      })}
    </div>

    {/* Empty view fallback states */}
    <div id="filter-empty-state" class="hidden text-center py-12 text-ink-muted text-sm border border-dashed border-border rounded-lg bg-white mt-6">
      Không tìm thấy sự kiện nào thuộc quốc gia này.
    </div>

  </main>
</Layout>

<script>
  const filterContainer = document.querySelector('[data-event-filters]');
  const buttons = filterContainer?.querySelectorAll<HTMLButtonElement>('[data-filter-value]');
  const cards = document.querySelectorAll<HTMLElement>('.timeline-card-wrapper');
  const emptyState = document.getElementById('filter-empty-state');

  buttons?.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selectedValue = btn.getAttribute('data-filter-value');
      if (!selectedValue) return;

      // Reset style classes across filter buttons
      buttons.forEach((b) => {
        const isTarget = b === btn;
        b.classList.toggle('bg-brand-600', isTarget);
        b.classList.toggle('text-white', isTarget);
        b.classList.toggle('border-brand-600', isTarget);
        b.classList.toggle('bg-white', !isTarget);
        b.classList.toggle('text-ink-muted', !isTarget);
        b.classList.toggle('border-border', !isTarget);
        
        const activeFont = b.querySelector('.font-medium');
        if (activeFont) b.classList.toggle('font-semibold', isTarget);
      });

      // Filter visibility logic across cards
      let visibleCount = 0;
      cards.forEach((card) => {
        const targetCountry = card.getAttribute('data-country');
        if (selectedValue === 'all' || targetCountry === selectedValue) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Show/hide missing results block states
      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    });
  });
</script>

<style>
  details[open] .arrow-icon {
    transform: rotate(180deg);
  }
  details[open] .toggle-text {
    color: var(--color-brand-600, #ea580c);
  }
  details[open] .label-text {
    font-size: 0;
  }
  details[open] .label-text::before {
    content: "Thu gọn";
    font-size: 0.75rem;
  }
  details[open] summary {
    background-color: rgba(248, 250, 252, 0.6);
  }
</style>