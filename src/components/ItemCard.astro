---
import { slugify } from '../lib/utils';

export interface Props {
  prompt: string;
  category: string;
  slug: string;
  shareCount?: number;
  variant?: 'default' | 'compact';
}

const { prompt, category, slug, shareCount, variant = 'default' } = Astro.props;
const href = `/item/${slug}`;
const categoryHref = `/categories/${slugify(category)}`;
---

{variant === 'compact' ? (
<div class="block px-4 py-3 hover:bg-brand-50 transition-colors rounded-lg group">
    <a href={href} class="block">
      <p class="text-sm font-medium text-ink group-hover:text-brand-700 line-clamp-2">
        {prompt}
      </p>
    </a>
    <a 
      href={categoryHref} 
      class="mt-1 inline-block text-xs font-semibold text-brand-600 bg-brand-100 hover:bg-brand-200 px-2 py-0.5 rounded-full relative z-10 transition-colors"
    >
      {category}
    </a>
  </div>
) : (
  <article
    class="flex flex-col bg-white border border-border rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow h-full"
    data-trending-card
    data-slug={slug}
    data-count={shareCount ?? 0}
  >
    <div class="flex items-start justify-between gap-3 mb-3">
      <a 
        href={categoryHref} 
        class="inline-block text-xs font-bold tracking-wide text-brand-700 bg-brand-100 hover:bg-brand-200 px-2.5 py-1 rounded-full uppercase transition-colors cursor-pointer"
      >
        {category}
      </a>
      {shareCount !== undefined && (
        <span
          class="flex items-center gap-1 text-xs font-semibold text-orange-600"
          title="Lượt chia sẻ"
          data-share-badge
          style={shareCount === 0 ? 'display: none' : undefined}
        >
          <span aria-hidden="true">🔥</span>
          <span data-share-count>{shareCount.toLocaleString('vi-VN')}</span>
        </span>
      )}
    </div>
    <h3 class="text-base font-semibold text-ink leading-snug mb-4 line-clamp-3 flex-1">
      {prompt}
    </h3>
    <div class="flex items-center justify-between mt-auto pt-3 border-t border-border">
      <a href={href} class="text-sm font-semibold text-brand-600 hover:text-brand-800 transition-colors">
        Đọc ngay →
      </a>
      <slot name="actions" />
    </div>
  </article>
)}
